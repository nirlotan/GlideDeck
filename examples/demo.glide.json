  "path": [
    {
      "frame": "frame-overview",
      "transition": {
        "style": "smooth",
        "duration": 1.4,
        "easing": "ease_in_out_cubic"
      }
    },
    {
      "frame": "frame-title",
      "transition": {
        "style": "smooth",
        "duration": 1.4,
        "easing": "ease_in_out_cubic"
      },
      "notes": "# Welcome\n- Everything here runs locally: no cloud, no accounts.\n- Click once more to highlight the tagline.",
      "builds": [
        {
          "element": "tagline",
          "effect": "words",
          "trigger": "after_previous",
          "duration": 1.2,
          "delay": 0.1
        },
        {
          "element": "subtitle",
          "effect": "rise",
          "trigger": "with_previous",
          "duration": 0.6,
          "delay": 0.7
        },
        {
          "element": "tagline",
          "effect": "highlight",
          "duration": 0.7
        }
      ]
    },
    {
      "frame": "frame-canvas",
      "transition": {
        "style": "swoop",
        "duration": 1.3,
        "easing": "ease_in_out_cubic"
      },
      "builds": [
        {
          "element": "card-canvas-title",
          "effect": "rise",
          "trigger": "after_previous",
          "duration": 0.6,
          "delay": 0.1
        },
        {
          "element": "card-canvas-body",
          "effect": "fade",
          "trigger": "with_previous",
          "duration": 0.6,
          "delay": 0.35
        }
      ]
    },
    {
      "frame": "frame-text",
      "transition": {
        "style": "direct",
        "duration": 1.0,
        "easing": "ease_in_out_cubic"
      },
      "notes": "Mention PowerPoint import: File → Import PowerPoint, then Arrange on the path strip.",
      "builds": [
        {
          "element": "card-text-title",
          "effect": "rise",
          "trigger": "after_previous",
          "duration": 0.6,
          "delay": 0.1
        },
        {
          "element": "card-text-body",
          "effect": "fade",
          "trigger": "with_previous",
          "duration": 0.6,
          "delay": 0.35
        }
      ]
    },
    {
      "frame": "frame-motion",
      "transition": {
        "style": "punch",
        "duration": 1.1,
        "easing": "ease_in_out_cubic"
      },
      "notes": "Show the Animate tab and the Carousel template.",
      "builds": [
        {
          "element": "card-motion-title",
          "effect": "rise",
          "trigger": "after_previous",
          "duration": 0.6,
          "delay": 0.1
        },
        {
          "element": "card-motion-body",
          "effect": "fade",
