<?xml version="1.0" encoding="UTF-8"?>
<!--
  GlideDeck Windows installer (WiX Toolset 3.x).
  Built by packaging/windows/build-msi.ps1; see the README for details.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="GlideDeck"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="GlideDeck"
           UpgradeCode="{76EF1693-B131-4607-98D1-FB5B052387C3}">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="GlideDeck $(var.Version) — local-first zooming presentations" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of GlideDeck is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icons for advertised shortcuts must carry the key file's extension. -->
    <Icon Id="GlideDeck.exe" SourceFile="$(var.ExePath)" />
    <Property Id="ARPPRODUCTICON" Value="GlideDeck.exe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/nirlotan/GlideDeck" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RepoDir)\packaging\windows\license.rtf" />
    <UIRef Id="WixUI_InstallDir" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="GlideDeck">
          <Directory Id="EXAMPLESFOLDER" Name="examples" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*" Win64="yes">
        <File Id="GlideDeckExe" Source="$(var.ExePath)" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="GlideDeck"
                    Description="Local-first zooming presentations" WorkingDirectory="INSTALLFOLDER"
                    Icon="GlideDeck.exe" Advertise="yes" />
        </File>
        <!-- Make the `glidedeck` CLI available to scripts and agents. -->
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
      <Component Id="Readme" Guid="*" Win64="yes">
        <File Id="Readme" Source="$(var.RepoDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="License" Guid="*" Win64="yes">
        <File Id="License" Source="$(var.RepoDir)\LICENSE" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="EXAMPLESFOLDER">
      <Component Id="DemoDeck" Guid="*" Win64="yes">
        <File Id="DemoDeck" Source="$(var.RepoDir)\examples\demo.glide.json" KeyPath="yes" />
      </Component>
      <Component Id="ExampleOps" Guid="*" Win64="yes">
        <File Id="ExampleOps" Source="$(var.RepoDir)\examples\add-slide.ops.json" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*" Win64="yes">
        <Shortcut Id="DesktopShortcutLink" Name="GlideDeck" Target="[INSTALLFOLDER]glidedeck.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="GlideDeck.exe" />
        <RegistryValue Root="HKCU" Key="Software\GlideDeck" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="GlideDeck" Level="1" Display="expand" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="Readme" />
      <ComponentRef Id="License" />
      <ComponentRef Id="DemoDeck" />
      <ComponentRef Id="ExampleOps" />
      <Feature Id="Desktop" Title="Desktop shortcut" Level="1">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>
  </Product>
</Wix>
