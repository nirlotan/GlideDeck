// The GlideDeck site at https://nirlotan.com/GlideDeck/
//
//   npx wrangler deploy          publish (from this folder)
//   npx wrangler dev             preview at http://localhost:8787/GlideDeck/
//
// nirlotan.com itself is another Worker (nirlotan-site) on a Custom Domain. The routes
// below take precedence over it for these paths only, so the rest of the site is untouched.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glidedeck-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Videos go through worker.js, which answers byte-range requests.
    "run_worker_first": ["/GlideDeck/media/*.mp4"]
  },
  "routes": [
    { "pattern": "nirlotan.com/GlideDeck*", "zone_name": "nirlotan.com" },
    { "pattern": "nirlotan.com/glidedeck*", "zone_name": "nirlotan.com" },
    { "pattern": "www.nirlotan.com/GlideDeck*", "zone_name": "nirlotan.com" },
    { "pattern": "www.nirlotan.com/glidedeck*", "zone_name": "nirlotan.com" }
  ]
}
